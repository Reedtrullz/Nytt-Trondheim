{
  "name": "nytt-trondheim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm --filter @nytt/shared run build && pnpm --filter @nytt/frontend run build && pnpm --filter @nytt/server run build && pnpm --filter @nytt/worker run build",
    "dev": "concurrently -n api,web \"pnpm --filter @nytt/server run dev\" \"pnpm --filter @nytt/frontend run dev\"",
    "dev:worker": "pnpm --filter @nytt/worker run dev",
    "db:migrate": "pnpm --filter @nytt/server run db:migrate",
    "typecheck": "pnpm --filter @nytt/shared run build && pnpm -r --workspace-concurrency=1 --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:coverage-matcher": "vitest run packages/shared/test/article-coverage-golden.test.ts packages/shared/test/article-coverage-invariance.test.ts packages/shared/test/article-coverage-evidence.test.ts packages/shared/test/article-coverage-clustering.test.ts packages/shared/test/article-coverage-corrections.test.ts packages/shared/test/public-verification.test.ts",
    "smoke:source-captures": "tsx scripts/source-capture-smoke.ts",
    "test:e2e": "playwright test",
    "audit:production": "pnpm audit --prod --audit-level high"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.2",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.3",
    "@nytt/shared": "workspace:*",
    "pg": "^8.16.0",
    "tsx": "^4.20.3"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "2.4.0",
      "undici": "7.30.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "zod": ">=3 || >=4"
      }
    }
  }
}
